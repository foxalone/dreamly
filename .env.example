# Existing app/Firebase server configuration is also required by the worker.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively: FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# AI Video · Sora (all values are server/worker-only except the existing bucket name above)
OPENAI_API_KEY=
SORA_VIDEO_MODEL=sora-2
SORA_BATCH_PRICE_PER_SECOND_USD=0.05
# Video · Veo (Vertex AI, video-only 720p price)
VEO_PROJECT_ID=
VEO_LOCATION=us-central1
VEO_VIDEO_MODEL=veo-3.1-lite-generate-001
VEO_LITE_PRICE_PER_SECOND_USD=0.03
AI_VIDEO_PAID_GENERATION_ENABLED=false
AI_VIDEO_DAILY_BUDGET_USD=50
AI_VIDEO_MAX_JOBS_PER_DAY=20
AI_VIDEO_TTS_MODEL=tts-1-hd
AI_VIDEO_TTS_VOICE=nova
AI_VIDEO_WORK_DIR=
# AI Image · same OpenAI / Vertex credentials as Sora and Veo.
# Image models are cheaper stills APIs, not the video models themselves.
SORA_IMAGE_MODEL=gpt-image-1-mini
SORA_IMAGE_PRICE_USD=0.015
VEO_IMAGE_MODEL=gemini-3.1-flash-image
VEO_IMAGE_LOCATION=global
VEO_IMAGE_PRICE_USD=0.07
# Optional. Falls back to AI_VIDEO_PAID_GENERATION_ENABLED when omitted.
AI_IMAGE_PAID_GENERATION_ENABLED=
AI_IMAGE_DAILY_BUDGET_USD=10
AI_IMAGE_MAX_JOBS_PER_DAY=50
AI_IMAGE_WORK_DIR=
# Optional for Combined mode. When empty, the worker reuses the key from
# MONEYPRINTERTURBO_ROOT/config.toml.
PEXELS_API_KEY=
# Required for Free Mix unless pixabay_api_keys is configured in
# MONEYPRINTERTURBO_ROOT/config.toml.
PIXABAY_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PERSONAL_CHAT_ID=

# Server-side Buffer Personal Access Key used for TikTok publishing
BUFFER_API_KEY=
# Optional. Prefer this Buffer TikTok handle when multiple TikTok channels exist.
BUFFER_TIKTOK_USERNAME=dreamly_art

# Meta (Instagram Reels + Facebook Reels) admin publish
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://dreamly.art/api/admin/meta/callback
# Optional. Default v22.0
META_GRAPH_VERSION=
# Optional. Pin a specific Page / Instagram professional account
META_PAGE_ID=
META_IG_USER_ID=

# Threads (admin publish for @get.dreamly)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://dreamly.art/api/admin/threads/callback
# Optional. Base URL used for the data deletion status link. Default https://dreamly.art
THREADS_SITE_URL=

# Google Search Console (admin tab + daily Vercel cron)
# Reuses FIREBASE_SERVICE_ACCOUNT_JSON. Add that service-account email as a
# Search Console user on dreamly.art, and enable Search Console API in GCP.
# Optional. Default auto-detects sc-domain:dreamly.art or https://dreamly.art/
GSC_SITE_URL=
# Optional. Default 90.
GSC_LOOKBACK_DAYS=
# Required for /api/cron/gsc-sync. Vercel sends it as Authorization: Bearer.
CRON_SECRET=

# YouTube Shorts (admin publish, Google OAuth)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://dreamly.art/api/admin/youtube/callback
# Optional. public | unlisted | private. Default public. Note: uploads from an
# API project that has not passed YouTube's compliance audit are locked private.
YOUTUBE_PRIVACY_STATUS=
# Optional. YouTube category id, default 22 (People & Blogs)
YOUTUBE_CATEGORY_ID=
# Optional. Space separated scope override, default upload + readonly
YOUTUBE_SCOPES=

# Pinterest (admin publish, video pins)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=https://dreamly.art/api/admin/pinterest/callback
# Optional. Default "Dream Meanings & Interpretation"
PINTEREST_BOARD_NAME=
# Optional. Pin a specific board instead of looking it up by name
PINTEREST_BOARD_ID=
# Optional cover image when a video has no thumbnail. Default https://dreamly.art/opengraph-image
PINTEREST_COVER_FALLBACK_URL=

# Live Positioner journal (tab “Публикации”). Default is production.
# Override POSITIONER_URL / POSITIONER_PUBLISH_URL only for a local instance.
POSITIONER_URL=https://positioner-web.vercel.app
POSITIONER_PUBLISH_URL=https://positioner-web.vercel.app/api/publishes
# Optional. If set, sent as Authorization: Bearer and X-Positioner-Key.
POSITIONER_INGEST_SECRET=

# Notion keys are unused for live publishes (kept for optional backfill/views scripts)
NOTION_API_KEY=
NOTION_PUBLISH_DATA_SOURCE_ID=

# Optional binary overrides when ffmpeg/ffprobe are not on PATH.
FFMPEG_BIN=
FFPROBE_BIN=
