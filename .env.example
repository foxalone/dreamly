# Existing app/Firebase server configuration is also required by the worker.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively: FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# AI Video · Sora (all values are server/worker-only except the existing bucket name above)
OPENAI_API_KEY=
SORA_VIDEO_MODEL=sora-2
SORA_PRICE_PER_SECOND_USD=0.10
AI_VIDEO_PAID_GENERATION_ENABLED=false
AI_VIDEO_DAILY_BUDGET_USD=5
AI_VIDEO_MAX_JOBS_PER_DAY=2
AI_VIDEO_TTS_MODEL=tts-1-hd
AI_VIDEO_TTS_VOICE=nova
AI_VIDEO_WORK_DIR=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PERSONAL_CHAT_ID=

# Optional binary overrides when ffmpeg/ffprobe are not on PATH.
FFMPEG_BIN=
FFPROBE_BIN=
